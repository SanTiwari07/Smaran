# Copy to .env to override. Every service reads this file (backend/common/config.py).
GATEWAY_PORT=8000
DEVICE_A_PORT=8001
DEVICE_B_PORT=8002
GATEWAY_URL=http://127.0.0.1:8000

# server = Qdrant Server via Docker (infra/docker-compose.yml); embedded = no Docker
QDRANT_MODE=server
QDRANT_URL=http://127.0.0.1:6333
QDRANT_COLLECTION=smaran

DENSE_MODEL=BAAI/bge-small-en-v1.5
DENSE_DIM=384
MODELS_DIR=models
RUNTIME_DIR=runtime
LOG_DIR=logs

# Escalate a query to the cloud when the best local cosine is below this (and online)
ESCALATE_AT=0.55
# Drop a new note when it is this similar to fleet knowledge already in Agora
DEDUP_AT=0.95
SYNC_INTERVAL=2.0
SYNC_BATCH=20
# Dense vectors on the wire: f16 (base64 float16, ~8x smaller) or json (plain floats)
VECTOR_TRANSPORT=f16
