# Copy to .env to override. Every service reads this file (backend/common/config.py).
GATEWAY_PORT=8000
DEVICE_A_PORT=8001
DEVICE_B_PORT=8002
GATEWAY_URL=http://127.0.0.1:8000

# server = Qdrant Server via Docker (infra/docker-compose.yml); embedded = no Docker
QDRANT_MODE=server
QDRANT_URL=http://127.0.0.1:6333
QDRANT_COLLECTION=smaran

DENSE_MODEL=BAAI/bge-small-en-v1.5
DENSE_DIM=384
MODELS_DIR=models
RUNTIME_DIR=runtime
LOG_DIR=logs

# Escalate a query to the cloud when the best local cosine is below this (and online)
ESCALATE_AT=0.55
# Drop a new note when it is this similar to fleet knowledge already in Agora
DEDUP_AT=0.95
SYNC_INTERVAL=2.0
SYNC_BATCH=20
# Dense vectors on the wire: f16 (base64 float16, ~8x smaller) or json (plain floats)
VECTOR_TRANSPORT=f16

# ---- Personal companion (the student / developer assistant on top of the edge engine) ----
# personal = companion rules and campus seed data; fleet = the original maintenance-notes domain
SMARAN_DOMAIN=personal
SEED_DIR=seed/campus
# On-device small language model, served locally by Ollama (llama.cpp). `ollama pull llama3.2`
LOCAL_LLM_URL=http://127.0.0.1:11434
LOCAL_LLM_MODEL=llama3.2:latest
# Optional cloud enhancement (any OpenAI-compatible endpoint). Leave empty to stay fully local.
# It is only ever used when online, requested, and the context holds no private memory.
CLOUD_LLM_URL=
CLOUD_LLM_KEY=
CLOUD_LLM_MODEL=

# Google Gemini API for cloud LLM answers.
# Set your Gemini API key here to enable Gemini-powered answers when online.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
